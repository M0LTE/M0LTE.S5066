// s5066d two-node bench configuration, node 2 of 2 (the other is bench-node1.json).
// Run both on one machine; they talk MS110D over UDP audio on ports 7300 and 7301.
//
// Only for a bench: the CSMA and timeout values below are much shorter than the standard's
// defaults (example.json keeps those), so one confirmed message takes seconds instead of 30 to
// 90 s. The standard makes the wait after DCD long because DCD can drop early in a fade
// [Ed4 K.4, p.K-12]; these short waits give no such margin, so do not use them on air.
{
  "local_address": "0.0.1.2",
  // 4 contention slots of 1 s; wait 2 s after DCD and 0.5 s after VDCD before talking. A slot must
  // outlast the time the far modem takes to hear us start (K-0048): over UDP audio that is the
  // 0.72 s preamble plus about 50 ms. Narrower slots make every contention a collision (issue #86).
  "csma": { "mode": "jitter", "num_cont_slots": 4, "cont_slot_width_ms": 1000, "lbt_wait_dcd_ms": 2000, "lbt_wait_vdcd_ms": 500 },
  "drc": { "default_speed": { "wn": 6, "interleaver": "short" } },
  // Link requests are repeated five times and link breaks three times. Their timeouts are unset,
  // so each is one acknowledgement wait.
  "cas": { "max_links": 4, "link_request_retries": 5, "break_retries": 3 },
  // Transmissions of at most 6 s. The acknowledgement wait is unset, so it is derived: 6 s for the
  // peer's own transmission, 2 s of listening and 4 s of contention, 12 s in all.
  "dts": { "max_transmission_ms": 6000 },
  "host": {
    "sis_listen": "127.0.0.1:5067",
    "modem": { "kind": "ms110d", "audio_listen": "127.0.0.1:7301", "audio_peer": "127.0.0.1:7300" }
  }
}
