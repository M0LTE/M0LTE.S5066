// s5066d example configuration (core-architecture.md 12.9). Keys not set here take the
// corpus defaults built into the host.
//
// CSMA is left at the standard's defaults [Ed4 K Table 7, p.K-12]: 16 contention slots of
// 3 s, a 30 s listen-before-talk wait after DCD and 3 s after VDCD. Those suit a real HF net,
// but they make every exchange slow: expect 30 to 90 s for one confirmed message between two
// nodes. For two nodes on a bench, use bench-node1.json and bench-node2.json instead.
{
  "local_address": "0.0.1.1",
  "csma": { "mode": "jitter" },
  "drc": { "default_speed": { "wn": 6, "interleaver": "short" } },
  // The standard leaves these counts to the operator and gives no value [Ed4 B.7.2.1 Step 3,
  // p.B-28; B.7.2.8 Step 3, p.B-36], so s5066d refuses a file without them. An unanswered link
  // request or link break is sent again this many times before the node gives up.
  "cas": { "max_links": 4, "link_request_retries": 3, "break_retries": 3 },
  "host": {
    "sis_listen": "127.0.0.1:5066",
    "modem": { "kind": "ms110d", "audio_listen": "0.0.0.0:7300", "audio_peer": "127.0.0.1:7301" }
  }
}
