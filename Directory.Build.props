<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Bump this in the same commit as the v<version> tag; publish.yml refuses a tag that does not match. -->
    <Version>0.1.2</Version>
    <Authors>Tom Fanning M0LTE</Authors>
    <Company>M0LTE</Company>
    <Copyright>Copyright (c) 2026 Tom Fanning M0LTE</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/M0LTE/M0LTE.S5066</PackageProjectUrl>
    <RepositoryUrl>https://github.com/M0LTE/M0LTE.S5066</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
